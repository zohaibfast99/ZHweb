# Gmail account used to send contact-form mail.
# EMAIL_PASS must be a Google App Password, not the account password.
EMAIL_USER=you@example.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Optional: inbox that receives contact-form submissions (defaults to EMAIL_USER).
CONTACT_TO=you@example.com

# Optional: port the server listens on (defaults to 3000).
PORT=3000
